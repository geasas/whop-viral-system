# .gitignore — Whop Viral System

# Credentials & env (NEVER commit)
.env
.env.*
!.env.template
client_secret.json
token.json
*.key
*.pem
secrets/
credentials/

# Cache
.cache/
.cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
*.egg

# Logs
logs/
*.log
errors.log

# State (per-environment)
state.json
*.state
.cache_state.json

# Build
build/
dist/
*.tar.gz
*.zip

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test artifacts
tmp/
*.tmp
*.temp
test_*.mp4
test_*.wav
*.test.mp4

# Whisper models (downloaded)
*.bin
*.pt
*.safetensors
whisper-cache/
models/

# OS
.DS_Store
.DS_Store?
._*

# Local docs (per-user)
my_notes.md
private_*.md

# Backups
*.bak
*.old
backup/
backups/

# Node (optional, for Whop CLI)
node_modules/
package-lock.json
yarn.lock

# Venv (optional)
venv/
env/
ENV/

# Coverage
.coverage
htmlcov/
.tox/
.pytest_cache/

# Database (local)
*.db
*.sqlite
*.sqlite3
