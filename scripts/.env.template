# ================================================
# Whop Viral System — .env template
# Copy this file to .env and fill in your tokens.
# NEVER commit .env to git (it's in .gitignore).
# ================================================

# === TikTok Content Posting API ===
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# === Instagram Graph API ===
# Get from: https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/callback

# === YouTube Data API v3 ===
# Get from: https://console.cloud.google.com/
YOUTUBE_CLIENT_SECRET_JSON=.credentials/client_secret.json
YOUTUBE_TOKEN_JSON=.credentials/token.json
YOUTUBE_CHANNEL_ID=

# === Whop API ===
# Get from: https://whop.com → Settings → Developer
WHOP_API_KEY=
WHOP_BEARER_TOKEN=
WHOP_USER_ID=
WHOP_CLI_PATH=/usr/local/bin/whop

# === B-Roll Sources (free) ===
PEXELS_API_KEY=
PIXABAY_API_KEY=

# === Optional: Stable Diffusion WebUI (local) ===
STABLE_DIFFUSION_WEBUI_URL=http://127.0.0.1:7860
STABLE_DIFFUSION_MODEL=v1-5-pruned-emaonly.safetensors

# === System ===
LOG_LEVEL=INFO
STATE_FILE=state.json
CACHE_DIR=.cache
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# === Optional: Telegram alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
